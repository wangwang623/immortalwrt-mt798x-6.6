#!/bin/sh
# 首次启动执行一次：LAN / DHCP / zram 默认值。
# 之后以 /etc/config 里用户或 LuCI 的设置为准；不校验、不拦截。
# 重刷或 sysupgrade -n 后随新固件再次生效。

uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.31.1'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set system.@system[0].zram_size_mb='64'
set system.@system[0].zram_comp_algo='lzo'
EOF
uci commit
exit 0
