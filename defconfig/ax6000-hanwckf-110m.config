# ==============================================================================
# Redmi AX6000 · hanwckf U-Boot 110M 大分区
# 源码: wangwang623/immortalwrt-mt798x-6.6 (分支 openwrt-24.10-6.6)
#
# 布局核对结论（已查源码 DTS，非推测）：
#   padavanonly 的 ax6000-ubootmod DTS:
#     &spi_nand_flash { mediatek,nmbm; ... };
#     partition@580000 crash      0x40000
#     partition@5c0000 crash_log  0x40000
#     partition@600000 ubi        0x6e00000   ← 110 MiB
#   → 与 hanwckf bl-mt798x 的 "immortalwrt-110m" 完全一致，可直接刷
#   → 与官方 OpenWrt ubootmod(0x580000 / 122.5M / 无 nmbm) 不同，勿混用
# ==============================================================================

# ------------------------------------------------------------------ 目标平台
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# ★ 决定编译哪个机型（名字来自 filogic.mk 的 TARGET_DEVICES +=）
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y

# ------------------------------------------------------------------ RootFS
# ★ INITRAMFS 必须开：ax6000-ubootmod 的 initramfs-factory.ubi
#   由 initramfs-recovery.itb 生成，不开就出不来首次刷机文件
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 不需要 UBIFS：Device/Default 里 FILESYSTEMS := squashfs
# sysupgrade.bin = sysupgrade-tar | append-metadata，只需要 kernel + squashfs

# ------------------------------------------------------------------ 无线（闭源）
# 本源码为 padavanonly MT798x 分支：
#   package/kernel/mt76  不存在（kmod-mt7915e 是死引用，会被静默丢弃）
#   package/mtk/drivers/mt_wifi  存在
#   package/mtk/drivers/wifi-profile/files/mt7986/l1profile.dat  存在 → 支持 7986
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg=y

# l1profile.dat 的安装由这两个符号决定（MT7986 专用）
CONFIG_first_card=y
CONFIG_first_card_name="MT7986"

# MTK 闭源驱动的开关符号在 config.in 里是 default y
# ★ 必须显式写 is not set，否则会被默认打开 —— 漏抄会导致编译失败
# （若编译报 PRE_CAL / TRX 相关错误，按实际 config.in 补齐这里的 is not set）
# # CONFIG_MTK_PRE_CAL_TRX_SET1 is not set
# # CONFIG_MTK_PRE_CAL_TRX_SET2 is not set

# ------------------------------------------------------------------ 无线（开源）不可用
# ⚠️ 已核实：本源码没有开源 mt76，AX6000 只能用闭源 mt_wifi。
#    package/kernel/mt76/Makefile      → 404（10/10 次，权威不存在）
#    package/firmware/mt7986-firmware  → 404
#    package/mtk/drivers/mt_wifi       → 200（存在）
#    package/mtk/drivers/wifi-profile/files/mt7986/l1profile.dat → 200（支持 7986）
#
# 这意味着 filogic.mk 里 DEVICE_PACKAGES 写的 kmod-mt7915e / kmod-mt7986-firmware
# 是【死引用】——defconfig 会静默丢弃，不会报错，但编出来没有无线。
# 所以下面闭源那几个包必须显式写 =y。
#
# 若换到官方 OpenWrt / ImmortalWrt 主线源码（含 package/kernel/mt76），
# 才可以把上面闭源块注释掉、改用：
# CONFIG_PACKAGE_kmod-mt7915e=y
# CONFIG_PACKAGE_kmod-mt7986-firmware=y
# CONFIG_PACKAGE_mt7986-wo-firmware=y

# ------------------------------------------------------------------ 网页界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ------------------------------------------------------------------ 网络基础
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y

# ------------------------------------------------------------------ HTTPS 支撑
# opkg 装包需要，否则 https 源装不了
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y

# ------------------------------------------------------------------ 通用
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_kmod-leds-ws2812b=y

# ------------------------------------------------------------------ 调试（默认全关）
# CONFIG_DEVEL is not set
# CONFIG_CCACHE is not set
# CONFIG_DEBUG is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
